{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--chromeArg=--disable-blink-features=AutomationControlled"
      ]
    },
    "github": {
      "type": "local",
      "enabled": true,
      "command": [
        "github-mcp-server-mcp"
      ]
    }
  }
}
